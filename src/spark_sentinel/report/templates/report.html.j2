<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spark Sentinel report: {{ verdict }}</title>
<style>
  :root {
    --ground: #F2F5F3; --paper: #FAFBFA; --ink: #16212B; --soft: #4F5D66; --rule: #C8D1CD;
    --bar-base: #C3CEC9; --high: #B8322A; --medium: #B87005; --low: #2F7A86; --info: #5E6B74;
    --ok: #2E7D4F;
    --serif: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
    --mono: ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #10171C; --paper: #151E24; --ink: #E4EBE8; --soft: #9AA9A3; --rule: #2C3A40;
      --bar-base: #34454C; --high: #E5675D; --medium: #E3A23A; --low: #5DB3C0; --info: #95A3AB;
      --ok: #5CB883;
    }
  }
  * { box-sizing: border-box; }
  html { background: var(--ground); color: var(--ink); }
  body {
    margin: 0 auto; max-width: 52rem; padding: 3rem 1.5rem 4rem;
    font: 1.0625rem/1.6 var(--serif); font-variant-numeric: lining-nums tabular-nums;
  }
  code, .mono { font-family: var(--mono); font-size: 0.86em; }
  a { color: inherit; text-underline-offset: 0.18em; }
  a:focus-visible { outline: 2px solid var(--low); outline-offset: 3px; border-radius: 2px; }

  header.top { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
               color: var(--soft); font-size: 0.9rem; border-bottom: 1px solid var(--rule);
               padding-bottom: 0.6rem; }
  header.top strong { color: var(--ink); font-weight: 600; }

  .verdict { margin: 2.6rem 0 0.4rem; font-size: clamp(2.1rem, 5vw, 3.1rem); line-height: 1.08;
             font-weight: 700; letter-spacing: -0.015em; }
  .verdict.clean { color: var(--ok); }
  .worst { margin: 0 0 1.6rem; max-width: 40rem; font-size: 1.2rem; color: var(--soft); }
  .worst b { color: var(--ink); font-weight: 600; }

  .tally { display: flex; gap: 1.4rem; flex-wrap: wrap; margin: 0 0 2.2rem; padding: 0;
           list-style: none; font-size: 0.95rem; }
  .tally li { display: flex; align-items: center; gap: 0.45rem; }
  .tally .swatch { width: 0.8rem; height: 0.8rem; border-radius: 2px; background: var(--c); }
  .tally .zero { color: var(--soft); opacity: 0.6; }

  nav.apps { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
             padding: 0.9rem 0; margin-bottom: 1rem; }
  nav.apps ol { list-style: none; margin: 0; padding: 0; columns: 2 18rem; column-gap: 2rem; }
  nav.apps li { break-inside: avoid; padding: 0.15rem 0; display: flex; gap: 0.6rem;
                align-items: baseline; }
  nav.apps .count { margin-left: auto; color: var(--soft); font-size: 0.9rem; white-space: nowrap; }
  .mark { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c);
          flex: none; transform: translateY(-0.08rem); }

  section.app { margin-top: 3rem; }
  section.app > h2 { margin: 0; font-size: 1.55rem; line-height: 1.2; font-weight: 700; }
  section.app > .about { margin: 0.25rem 0 1.4rem; color: var(--soft); font-size: 0.95rem; }
  .partial { border-left: 3px solid var(--medium); padding: 0.3rem 0 0.3rem 0.9rem;
             margin: 0 0 1.4rem; font-size: 0.95rem; }
  .none { color: var(--ok); margin: 0; }

  article.finding { border-left: 0.35rem solid var(--c); background: var(--paper);
                    padding: 1.1rem 1.4rem 1.2rem 1.3rem; margin: 0 0 1.4rem; }
  .finding .sev { font-size: 0.82rem; font-weight: 700; color: var(--c); letter-spacing: 0.02em; }
  .finding .sev code { color: var(--soft); font-weight: 400; margin-left: 0.5rem; }
  .finding h3 { margin: 0.15rem 0 0.2rem; font-size: 1.22rem; line-height: 1.3; font-weight: 600; }
  .finding .where { margin: 0 0 1rem; color: var(--soft); font-size: 0.92rem; }

  .evidence { margin: 0 0 1rem; padding: 0; list-style: none; display: grid; gap: 0.7rem; }
  .evidence .label { font-size: 0.93rem; }
  .evidence .plain b { font-weight: 600; }
  .bars { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.8rem;
          row-gap: 0.2rem; align-items: center; margin-top: 0.25rem; font-size: 0.88rem; }
  .bar { height: 0.7rem; border-radius: 1px; min-width: 2px; }
  .bar.value { background: var(--c); }
  .bar.base { background: var(--bar-base); }
  .bars .v { font-weight: 600; }
  .bars .b { color: var(--soft); }
  .ratio { font-size: 0.85rem; color: var(--soft); margin-top: 0.15rem; }

  .why { margin: 0 0 0.9rem; }
  .why code, .fixes code { background: var(--ground); padding: 0 0.15em; border-radius: 2px;
                           overflow-wrap: anywhere; }
  .fixes h4 { margin: 0 0 0.3rem; font-size: 0.95rem; font-weight: 700; }
  .fixes ol { margin: 0; padding-left: 1.3rem; }
  .fixes li { margin-bottom: 0.35rem; padding-left: 0.2rem; }

  .docs { margin: 0.9rem 0 0; font-size: 0.9rem; color: var(--soft); }
  .docs a { color: var(--ink); }
  .errors { margin-top: 3rem; border-left: 0.35rem solid var(--high); padding-left: 1.2rem; }
  footer { margin-top: 3.5rem; border-top: 1px solid var(--rule); padding-top: 0.8rem;
           color: var(--soft); font-size: 0.88rem; }

  .s-high { --c: var(--high); } .s-medium { --c: var(--medium); }
  .s-low { --c: var(--low); } .s-info { --c: var(--info); } .s-ok { --c: var(--ok); }

  @media (max-width: 34rem) {
    body { padding: 2rem 1rem 3rem; font-size: 1rem; }
    article.finding { padding: 0.9rem 1rem; }
  }
  @media print {
    html { background: #fff; }
    article.finding { break-inside: avoid; background: none; }
    nav.apps { display: none; }
  }
</style>
</head>
<body>
<header class="top">
  <span><strong>Spark Sentinel</strong> report</span>
  <span>Generated {{ report.generated_at }}</span>
</header>

<main>
  <h1 class="verdict{% if not report.findings %} clean{% endif %}">{{ verdict }}</h1>
  {% if worst %}
  <p class="worst">The most serious is in {{ app_names[worst.location.app_id] }}:<br><b>{{ worst.title }}</b></p>
  {% else %}
  <p class="worst">Every rule ran and none found a problem.</p>
  {% endif %}

  <ul class="tally" aria-label="Findings by severity">
    {% for sev, n in counts %}
    <li class="s-{{ sev.name|lower }}{% if not n %} zero{% endif %}">
      <span class="swatch" aria-hidden="true"></span>{{ n }} {{ sev.name|lower }}
    </li>
    {% endfor %}
  </ul>

  {% if report.apps|length > 1 %}
  <nav class="apps" aria-label="Apps in this report">
    <ol>
      {% for app in report.apps %}
      <li class="s-{{ worst_class(app) }}">
        <span class="mark" aria-hidden="true"></span>
        <a href="#{{ anchor(app) }}">{{ app.app_name or app.app_id }}</a>
        <span class="count">{{ problems(app.findings|length) }}</span>
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  {% for app in report.apps %}
  <section class="app" id="{{ anchor(app) }}">
    <h2>{{ app.app_name or app.app_id }}</h2>
    <p class="about">{{ about(app) }}</p>
    {% if not app.completed %}
    <p class="partial">This log has no ApplicationEnd event: the app was still running or
      crashed, so these results may be incomplete.</p>
    {% endif %}
    {% if not app.findings %}
    <p class="none">No problems found.</p>
    {% endif %}

    {% for f in app.findings %}
    <article class="finding s-{{ f.severity.name|lower }}">
      <div class="sev">{{ f.severity.name|capitalize }}<code>{{ f.rule_id }}</code></div>
      <h3>{{ f.title }}</h3>
      <p class="where">{{ where(f.location) }}{% if f.location.sql_description %}, from
        <code>{{ f.location.sql_description }}</code>{% endif %}</p>

      <ul class="evidence">
        {% for e in f.evidence %}
        {% set b = bars(e) %}
        {% if b %}
        <li>
          <div class="label">{{ e.label|first_upper }}</div>
          <div class="bars" role="img" aria-label="{{ e }}">
            <div class="bar value" style="width: {{ b.value_pct }}%"></div><span class="v">{{ b.value }}</span>
            <div class="bar base" style="width: {{ b.base_pct }}%"></div><span class="b">{{ b.base_label }} {{ b.base }}</span>
          </div>
          {% if b.ratio %}<div class="ratio">{{ b.ratio }}</div>{% endif %}
        </li>
        {% else %}
        <li class="plain">{{ e.label|first_upper }}: <b>{{ value(e) }}</b></li>
        {% endif %}
        {% endfor %}
      </ul>

      {% if f.cause %}<p class="why">{{ f.cause|code }}</p>{% endif %}
      {% if f.fix %}
      <div class="fixes">
        <h4>How to fix it, most effective first</h4>
        <ol>{% for fix in f.fix %}<li>{{ fix|code }}</li>{% endfor %}</ol>
      </div>
      {% endif %}
      {% if f.references %}
      <p class="docs">Spark docs: {% for r in f.references %}<a href="{{ r.url }}">{{ r.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
      {% endif %}
    </article>
    {% endfor %}
  </section>
  {% endfor %}

  {% if report.result.errors %}
  <section class="errors">
    <h2>Rules that crashed</h2>
    <p>Their results are missing from this report.</p>
    <ul>
      {% for e in report.result.errors %}
      <li><code>{{ e.rule_id }}</code> on <code>{{ e.app_id }}</code>: {{ e.message }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</main>

<footer>
  Thresholds: profile <code>{{ report.profile }}</code>{% for item in overrides %}, <code>{{ item }}</code>{% endfor %}.
  Spark Sentinel {{ report.sentinel_version }}.
</footer>
</body>
</html>
